---
import "../styles/pulse.css";
import { Code } from "astro:components";
import GitHubIcon from "../components/GitHubIcon.astro";

const features = [
  {
    tag: "Tracing",
    title: "End-to-end trace capture",
    desc: "Every prompt, completion, token count, latency, and cost stored with full request and response bodies.",
  },
  {
    tag: "Sessions",
    title: "Session timelines",
    desc: "Group related calls into sessions. See full conversations or agent runs as a timeline.",
  },
  {
    tag: "Analytics",
    title: "Cost and usage tracking",
    desc: "Track spend per model, per project, per session. Catch cost spikes before they hit your bill.",
  },
  {
    tag: "Routing",
    title: "Provider agnostic",
    desc: "OpenAI, Anthropic, OpenRouter. One SDK, consistent metrics across all providers.",
  },
  {
    tag: "Debugging",
    title: "Fast root-cause workflows",
    desc: "Pivot from aggregate analytics to individual traces and spans quickly when incidents happen.",
  },
  {
    tag: "Deployment",
    title: "Single-node to scale mode",
    desc: "Run as a single binary with built-in SQLite, or switch to Postgres + partitioned listeners for higher throughput.",
  },
];

const dashboardCards = [
  {
    title: "Command Center",
    src: "/assets/OverView.png",
    desc: "Overview of traces, spend, and live service health across your projects.",
  },
  {
    title: "Agent Run Playback",
    src: "/assets/agent-runs.png",
    desc: "Replay each agent run with tool calls, timing, and failure points in order.",
  },
  {
    title: "Cost Intelligence",
    src: "/assets/analytics.png",
    desc: "Track token usage and cost trends to catch spikes before they become problems.",
  },
];

const heroDashboard = {
  src: "/assets/OverView.png",
  alt: "Pulse dashboard overview screenshot",
};

const integrations = [
  {
    id: "claude",
    name: "Claude Code",
    logo: "/assets/claudecode.jpg",
    desc: "Capture tool events, sessions, and agent runs from Claude Code.",
    href: "/docs/claude-code/",
  },
  {
    id: "opencode",
    name: "Opencode",
    logo: "/assets/opencode.png",
    desc: "Stream Opencode execution events into Pulse timelines and analytics.",
    href: "/docs/opencode/",
  },
  {
    id: "openclaw",
    name: "OpenClaw",
    logo: "/assets/openclaw.png",
    desc: "Track OpenClaw sessions and tool activity alongside model traces.",
    href: "/docs/openclaw/",
  },
];

const docsCards = [
  {
    label: "Getting started",
    title: "Quickstart",
    desc: "Install the SDK, create an API key, and capture your first trace in under 5 minutes.",
    href: "/docs/",
  },
  {
    label: "SDK",
    title: "Provider adapters",
    desc: "Integrate with OpenAI, Anthropic, and OpenRouter using the observe() wrapper.",
    href: "/docs/providers/",
  },
  {
    label: "API",
    title: "REST API reference",
    desc: "Query traces, sessions, and analytics programmatically. Full endpoint documentation.",
    href: "/docs/api/",
  },
  {
    label: "Updates",
    title: "Release notes",
    desc: "See the latest product changes, DX improvements, and upgrade notes in one place.",
    href: "/docs/releases/",
  },
  {
    label: "Concepts",
    title: "Sessions & metadata",
    desc: "Group traces with session IDs and attach custom metadata for filtering.",
    href: "/docs/sessions/",
  },
  {
    label: "Config",
    title: "Configuration",
    desc: "Batching, flush intervals, disabling tracing, and all initPulse() options.",
    href: "/docs/config/",
  },
];

const codeTheme = "min-dark";

const serverInstallCode = String.raw`curl -fsSL https://raw.githubusercontent.com/EK-LABS-LLC/pulse/main/apps/server/scripts/install.sh | bash -s -- pulse-server`;

const installCode = String.raw`bun add @eklabs/pulse-sdk
pip install pulse-trace-sdk`;

const wrapCode = String.raw`const client = observe(
  new OpenAI({ apiKey: "sk-..." }),
  Provider.OpenAI
);`;

const statsCode = String.raw`142 traces captured
$0.47 total cost
avg latency 1.2s`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pulse - LLM Observability</title>
    <meta
      name="description"
      content="LLM observability for TypeScript and Python."
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body class="landing-body">
    <nav class="landing-nav">
      <div class="landing-nav-inner">
        <div class="landing-nav-left">
          <a href="/" class="brand">Pulse</a>
          <div class="landing-links">
            <a href="#quick-start">Quick start</a>
            <a href="#integrations">Integrations</a>
            <a href="#dashboard">Dashboard</a>
            <a href="#features">Features</a>
            <a href="#how-it-works">How it works</a>
            <a href="/docs/">Docs</a>
          </div>
        </div>
        <a
          href="https://github.com/EK-LABS-LLC/pulse"
          class="github-icon-link"
          aria-label="Pulse GitHub repository"
        >
          <GitHubIcon />
        </a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="hero-grid">
          <div>
            <h1>Observability for every LLM call your app makes</h1>
            <p>
              Trace prompts, completions, latency, tokens, and cost across OpenAI,
              Anthropic, and OpenRouter with a single SDK for TypeScript and
              Python.
            </p>
            <div class="hero-ctas">
              <a
                href="https://github.com/EK-LABS-LLC/pulse"
                class="btn btn-primary"
                rel="noopener noreferrer"
              >
                <GitHubIcon class="btn-icon" />
                GitHub
              </a>
              <a href="/docs/" class="btn btn-secondary">Read the docs</a>
            </div>
          </div>
          <div class="hero-dashboard-card">
            <img src={heroDashboard.src} alt={heroDashboard.alt} loading="eager" />
          </div>
        </div>
      </section>

      <section id="quick-start" class="landing-section quickstart-section">
        <div class="section-head quickstart-head">
          <div class="eyebrow">Quick start</div>
          <h2>Install Pulse server first</h2>
          <p>
            Run this script to install the Pulse server and CLI binaries, then start
            instrumenting with the SDK.
          </p>
        </div>
        <div class="code-card quickstart-code-card">
          <div class="code-card-head">
            <span>Server install script</span>
            <button
              type="button"
              class="copy-install-btn"
              data-copy-value={serverInstallCode}
              aria-label="Copy install script"
            >
              Copy
            </button>
          </div>
          <Code
            code={serverInstallCode}
            lang="bash"
            theme={codeTheme}
            defaultColor="dark"
            class="landing-code-block quickstart-code-block"
          />
        </div>
      </section>

      <section id="integrations" class="landing-section integrations-section">
        <div class="section-head">
          <div class="eyebrow">Integrations</div>
          <h2>Works with the agents your team already uses</h2>
          <p>
            Native integrations for agent runtimes and CLIs so traces, runs, and
            tool activity land in one system.
          </p>
        </div>
        <div class="integrations-grid">
          {
            integrations.map((integration) => (
              <a href={integration.href} class="integration-card">
                <img
                  class={`integration-logo integration-logo--${integration.id}`}
                  src={integration.logo}
                  alt={`${integration.name} logo`}
                  loading="lazy"
                />
                <h3>{integration.name}</h3>
                <p>{integration.desc}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section id="dashboard" class="landing-section">
        <div class="section-head">
          <div class="eyebrow">Dashboard</div>
          <h2>See exactly what your team will use day to day</h2>
          <p>
            Fast visibility for tracing, run replay, triage, and spend decisions.
          </p>
        </div>
        <div class="dashboard-grid">
          {
            dashboardCards.map((card) => (
              <article class="dashboard-card">
                <div class="dashboard-media">
                  <img src={card.src} alt={`${card.title} dashboard screenshot`} loading="lazy" />
                </div>
                <div class="dashboard-caption">
                  <h3>{card.title}</h3>
                  <p>{card.desc}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="features" class="landing-section">
        <div class="section-head">
          <div class="eyebrow">Features</div>
          <h2>Everything you need to understand your LLM stack</h2>
          <p>
            From individual traces to full session timelines, Pulse gives your
            team the visibility to ship with confidence.
          </p>
        </div>
        <div class="feature-grid">
          {
            features.map((f) => (
              <article class="feature-card">
                <div class="feature-tag">{f.tag}</div>
                <h3>{f.title}</h3>
                <p>{f.desc}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="how-it-works" class="landing-section">
        <div class="section-head">
          <div class="eyebrow">How it works</div>
          <h2>Instrument in minutes, not days</h2>
          <p>Three steps to full observability across your LLM stack.</p>
        </div>
        <div class="how-grid">
          <article class="how-card">
            <div class="step">Step 01</div>
            <h3>Install the SDK</h3>
            <p>Add the SDK to your project. Works with JS/TS and Python runtimes.</p>
            <Code
              code={installCode}
              lang="bash"
              theme={codeTheme}
              defaultColor="dark"
              class="landing-code-block how-code-block"
            />
          </article>
          <article class="how-card">
            <div class="step">Step 02</div>
            <h3>Wrap your LLM client</h3>
            <p>Call <code>observe()</code> on your existing client. No API rewrite.</p>
            <Code
              code={wrapCode}
              lang="ts"
              theme={codeTheme}
              defaultColor="dark"
              class="landing-code-block how-code-block"
            />
          </article>
          <article class="how-card">
            <div class="step">Step 03</div>
            <h3>Open the dashboard</h3>
            <p>Traces flow in automatically. Search, filter, and analyze quickly.</p>
            <Code
              code={statsCode}
              lang="text"
              theme={codeTheme}
              defaultColor="dark"
              class="landing-code-block how-code-block"
            />
          </article>
        </div>
      </section>

      <section class="landing-section">
        <div class="section-head">
          <div class="eyebrow">Documentation</div>
          <h2>Everything you need to track your agent usage</h2>
          <p>Guides, API reference, and examples to get from zero to production.</p>
        </div>
        <div class="docs-grid">
          {
            docsCards.map((d) => (
              <a href={d.href} class="docs-card">
                <div class="docs-label">{d.label}</div>
                <h3>{d.title}</h3>
                <p>{d.desc}</p>
                <span>Read guide →</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cta-section">
        <h2>Start tracking your agents</h2>
        <p>Free and open source. Self-host anywhere.</p>
        <div class="hero-ctas">
          <a
            href="https://github.com/EK-LABS-LLC/pulse"
            class="btn btn-primary"
            rel="noopener noreferrer"
          >
            <GitHubIcon class="btn-icon" />
            GitHub
          </a>
          <a href="/docs/" class="btn btn-secondary">Read the docs</a>
        </div>
      </section>
    </main>
    <script is:inline>
      const copyButtons = document.querySelectorAll(".copy-install-btn");
      const navSectionLinks = document.querySelectorAll('.landing-links a[href^="#"]');
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const fallbackCopy = (value) => {
        const textarea = document.createElement("textarea");
        textarea.value = value;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "absolute";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
      };

      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const value = button.getAttribute("data-copy-value");
          if (!value) return;

          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(value);
            } else {
              fallbackCopy(value);
            }
            const prev = button.textContent;
            button.textContent = "Copied";
            window.setTimeout(() => {
              button.textContent = prev || "Copy";
            }, 1300);
          } catch {
            button.textContent = "Failed";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1300);
          }
        });
      });

      navSectionLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (!href || href === "#") return;

          const target = document.querySelector(href);
          if (!target) return;

          event.preventDefault();
          target.scrollIntoView({
            behavior: prefersReducedMotion ? "auto" : "smooth",
            block: "start",
          });
          window.history.pushState(null, "", href);
        });
      });
    </script>
  </body>
</html>
